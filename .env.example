# =============================================================================
# Backend environment template. Copy to `.env` and fill in real values.
#   cp .env.example .env
# The real .env is gitignored. Spring loads it via spring.config.import.
# =============================================================================

# --- Database ---
DB_URL=jdbc:postgresql://<host>/<database>
DB_USERNAME=
DB_PASSWORD=

# --- Frontend origin (CORS) ---
FRONTEND_URL=http://localhost:3000

# --- Access-token signing key (REQUIRED; the app will not start without it) ---
# Base64-encoded, at least 32 bytes. Generate a fresh one per environment:
#     openssl rand -base64 32
# This key authenticates every request, so treat it like a database password:
# never commit it, never paste it into a ticket, never log it. The key that used
# to live in JwtConstant.java has been retired -- the application refuses to boot
# if it is supplied again, because it is public in this repository's git history.
# Changing this value invalidates every issued token; members sign in again.
JWT_SECRET=

# Token lifetime in milliseconds. Optional; default 10800000 (3 hours).
#JWT_EXPIRATION_MS=10800000

# --- Tenant isolation ---------------------------------------------------------
# Hibernate @Filter safety net. Optional; default true. Isolation does not depend
# on it (scoped repository queries do the work), so it can be switched off to
# diagnose a query without opening a cross-tenant hole.
#TENANT_HIBERNATE_FILTER_ENABLED=true

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack ---
# The PLATFORM's secret key, and a server-side application secret: it is never
# stored per cooperative and never sent to the frontend.
PAYSTACK_SECRET_KEY=

# How each member payment is split when COOPR8 creates a cooperative's settlement
# subaccount (Paystack's `percentage_charge`). DELIBERATELY NO DEFAULT: unset, the
# app refuses to create a subaccount rather than routing money by accident. Confirm
# the intended number -- and which side of the split Paystack's field names -- before
# the first cooperative is onboarded in production.
PAYSTACK_PLATFORM_PERCENTAGE_CHARGE=

# --- Mail (Gmail SMTP app password) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Gemini / Google AI (hardcopy membership form scanning) ---
# Create a free key at https://aistudio.google.com/apikey. Required only for the
# "scan form" / "Forms -> Excel" admin features; keep it secret, never commit.
GEMINI_API_KEY=
# Optional model override. Default gemini-flash-lite-latest — an alias Google keeps
# pointed at the current GA Flash-Lite model. Flash-Lite has the most generous free
# quota (~15 requests/min, 1,000/day) which matters for batch form scanning, and is
# an alias so it won't break when a version is retired. For sharper handwriting OCR
# at a lower free quota, use gemini-flash-latest instead; pin a concrete version
# (e.g. gemini-3.5-flash-lite) if you need reproducible output.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Platform Super Admin (Initial bootstrap credentials) ---
# Used only if platform_admins table is completely empty on startup.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_INITIAL_PASSWORD=
